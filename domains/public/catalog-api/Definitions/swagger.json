{
  "openapi": "3.0.0",
  "info": {
    "title": "CatalogAPI",
    "version": "1.0",
    "description": "Public product catalog — visible to anonymous users in the developer portal."
  },
  "paths": {
    "/products": {
      "get": {
        "summary": "List all products",
        "operationId": "listProducts",
        "tags": ["Catalog"],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Product" }
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Get product by ID",
        "operationId": "getProduct",
        "tags": ["Catalog"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Product details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" }
              }
            }
          },
          "404": { "description": "Product not found" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id":          { "type": "string" },
          "name":        { "type": "string" },
          "category":    { "type": "string" },
          "description": { "type": "string" },
          "price":       { "type": "number", "format": "float" }
        }
      }
    }
  }
}
